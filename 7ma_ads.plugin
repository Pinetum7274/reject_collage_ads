#!name = 7ma广告屏蔽
#!desc = 拦截7ma/7mate校园电单车微信小程序广告：微信官方小程序广告(流量主banner/图片+激励视频) + 自有广告位(首页弹窗)
#!author = Pinetum7274
#!homepage = https://github.com/Pinetum7274/reject_collage_ads

[Script]
http-request ^https?://newmapi\.7mate\.cn/api/v1/banner/ script-path=https://raw.githubusercontent.com/Pinetum7274/reject_collage_ads/main/7ma_ads_rule.js, requires-body=false, tag=7ma_ads_自有广告位拦截

[Rule]
# ===== 微信官方小程序广告素材 =====
# 素材 CDN wximg.wxs.qq.com / wxsmw.wxs.qq.com 与微信聊天图片/视频共用，不能整域拦，
# 只能按 URL 特征拦（需对这两个域名开 MITM 才能看到 URL 路径/查询参数）：
#   1) 激励视频广告：URL 路径含 ads_svp_video（视频 ads_svp_video__*.mp4 + 封面 ads_svp_video__*.jpeg）
#   2) 图片/信息流/banner 广告：URL 查询参数带 posid=（广告位ID，本小程序固定 5060180989186180）
URL-REGEX,ads_svp_video,REJECT
URL-REGEX,posid=\d+,REJECT

[MITM]
hostname = newmapi.7mate.cn, wximg.wxs.qq.com, wxsmw.wxs.qq.com
