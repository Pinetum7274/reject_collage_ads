#!name = 7ma广告屏蔽
#!desc = 拦截7ma/7mate校园电单车微信小程序广告：微信官方小程序广告(流量主banner/图片+激励视频) + 自有广告位(首页弹窗)
#!author = Pinetum7274
#!homepage = https://github.com/Pinetum7274/reject_collage_ads

[Script]
http-request ^https?://newmapi\.7mate\.cn/api/v1/banner/ script-path=https://raw.githubusercontent.com/Pinetum7274/reject_collage_ads/main/7ma_ads_rule.js, requires-body=false, tag=7ma_ads_自有广告位拦截

[Rule]
# ===== 微信官方小程序广告素材 =====
# 素材 CDN wximg.wxs.qq.com / wxsmw.wxs.qq.com / wxsnsdythumb.wxs.qq.com 与微信聊天/朋友圈图片共用，
# 不能整域拦，只能按 URL 路径特征精确匹配（需对这些域名开 MITM 才能看到 URL 路径/查询参数）。
#
# 广告素材统一走微信 CDN 的「预留素材桶」路径（reserved 为广告系统预留桶标记，正常聊天图不走此路径）：
#   snscosdownload/<区域>/reserved/<hex>   图片/信息流/banner 广告 + 缩略图（可带可不带 posid=5060180989186180）
#   snssvpdownload/<区域>/reserved/<hex>   激励视频广告 mp4 + 封面 jpeg
URL-REGEX,^https?://.*\.wxs\.qq\.com/.*/snscosdownload/[^/]+/reserved/,REJECT
URL-REGEX,^https?://.*\.wxs\.qq\.com/.*/snssvpdownload/[^/]+/reserved/,REJECT
# 冗余兜底：广告位 ID posid= / 激励视频文件名 ads_svp_video（防止 reserved 路径将来变化）
URL-REGEX,^https?://.*\.wxs\.qq\.com/.*posid=\d+,REJECT
URL-REGEX,^https?://.*\.wxs\.qq\.com/.*ads_svp_video,REJECT

[Mitm]
hostname = newmapi.7mate.cn, wximg.wxs.qq.com, wxsmw.wxs.qq.com, wxsnsdythumb.wxs.qq.com
