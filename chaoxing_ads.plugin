#!name = 学习通广告屏蔽
#!desc = 拦截超星学习通全部广告：百度百青藤(sofire.baidu.com) + 自有广告位(getAdsRecommend 开屏/轮播banner/信息流推广)
#!author = Pinetum7274
#!homepage = https://github.com/Pinetum7274/reject_collage_ads

[Script]
http-request ^https?://home-yd\.chaoxing\.com/apis/data/getAdsRecommend script-path=https://raw.githubusercontent.com/Pinetum7274/reject_collage_ads/main/chaoxing_ads_rule.js, requires-body=false, tag=chaoxing_ads_自有广告位拦截

[Rule]
# ===== 百度百青藤广告 SDK（开屏/信息流广告下发 + 曝光上报） =====
DOMAIN,sofire.baidu.com,REJECT

[MITM]
hostname = home-yd.chaoxing.com
