#!name = 闲鱼广告屏蔽
#!desc = 拦截闲鱼(Xianyu)开屏/信息流广告：阿里妈妈AMDC调度(appkey=12431167)+自有广告位idleadv+穿山甲+阿里妈妈云视频广告CDN(cloudvideocdn)+优酷广告SDK(sealine)+阿里橙盾风控+AMDC直连IP
#!author = Pinetum7274
#!homepage = https://github.com/Pinetum7274/reject_collage_ads

[Script]
http-request ^https?://[^/]+/amdc/mobileDispatch script-path=https://raw.githubusercontent.com/Pinetum7274/reject_collage_ads/main/xianyu_ads_rule.js, requires-body=false, tag=xianyu_ads_阿里妈妈开屏拦截
http-request ^https?://acs\.m\.goofish\.com/gw/mtop\.idle\.idleadv\. script-path=https://raw.githubusercontent.com/Pinetum7274/reject_collage_ads/main/xianyu_ads_rule.js, requires-body=false, tag=xianyu_ads_自有广告位拦截

[Rule]
# ===== 阿里妈妈云视频广告 CDN（cloudvideocdn.taobao.com：alimama/mamasearchad/guangguang/video-zb/video-sh/video-nt/tbsvideo 子域，开屏/信息流广告视频素材） =====
DOMAIN-SUFFIX,cloudvideocdn.taobao.com,REJECT

# ===== 穿山甲 Pangle（字节跳动，广告竞价 get_ads + 统计上报） =====
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,ctobsnssdk.com,REJECT

# ===== 优酷广告 SDK（sealine.youku.com 广告下发） =====
DOMAIN-SUFFIX,sealine.youku.com,REJECT

# ===== 阿里橙盾（alibabachengdun.com 广告反作弊/风控上报） =====
DOMAIN,mum.alibabachengdun.com,REJECT

# ===== AMDC 直连 IP（绕过域名屏蔽，明文 HTTP 调度开屏广告） =====
IP-CIDR,59.82.0.0/16,REJECT
IP-CIDR,47.246.103.9/32,REJECT

[MITM]
hostname = amdc.m.taobao.com, amdcopen.m.taobao.com, amdc.wapa.taobao.com, acs.m.goofish.com
